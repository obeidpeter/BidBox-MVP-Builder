    },
    {
      "name": "bidbox.security.break_glass_activated",
      "type": "counter_delta",
      "unit": "activations",
      "source": "restricted_security_event_adapter",
      "sourceStatus": "deployment_adapter_required",
      "labels": []
    }
  ]
}
